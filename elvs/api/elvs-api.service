[Unit]
Description=elvs Geraete-Empfaenger fuer RustDesk (Port 21114)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /srv/rustdesk/elvs-api/elvs_api.py --data /var/lib/elvs-api
DynamicUser=yes
StateDirectory=elvs-api
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
