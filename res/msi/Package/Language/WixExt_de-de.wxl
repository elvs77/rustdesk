<WixLocalization Culture="de-de"
	xmlns="http://wixtoolset.org/schemas/v4/wxl">

	<!-- Firewall Extension needs translation here -->
	<String Id="msierrFirewallCannotConnect" Overridable="yes" Value="Keine Verbindung zur Windows-Firewall möglich. ([2]   [3]   [4]   [5])" />

	<String Id="WixSchedFirewallExceptionsInstall" Overridable="yes" Value="Windows-Firewall wird eingerichtet" />
	<String Id="WixSchedFirewallExceptionsUninstall" Overridable="yes" Value="Windows-Firewall wird eingerichtet" />
	<String Id="WixRollbackFirewallExceptionsInstall" Overridable="yes" Value="Firewall-Einstellungen werden zurückgesetzt" />
	<String Id="WixExecFirewallExceptionsInstall" Overridable="yes" Value="Firewall-Einstellungen werden installiert" />
	<String Id="WixRollbackFirewallExceptionsUninstall" Overridable="yes" Value="Firewall-Einstellungen werden zurückgesetzt" />
	<String Id="WixExecFirewallExceptionsUninstall" Overridable="yes" Value="Firewall-Einstellungen werden entfernt" />

	<!-- Util Extension does not need translation here, because it is already in official WiX Toolkit -->
	<String Id="msierrSecureObjectsFailedCreateSD" Overridable="yes" Value="Sicherheitsbeschreibung konnte nicht erstellt werden: [3]\[4], Fehler: [2]" />
	<String Id="msierrSecureObjectsFailedSet" Overridable="yes" Value="Sicherheitsbeschreibung konnte nicht angewendet werden: [3], Fehler: [2]" />
	<String Id="msierrSecureObjectsUnknownType" Overridable="yes" Value="Unbekannter Objekttyp [3], Fehler: [2]" />
</WixLocalization>